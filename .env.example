# Backend
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://sdas_admin:change_me@localhost:5432/sdas_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sdas_db
DB_USER=sdas_admin
DB_PASSWORD=change_me
JWT_SECRET=replace_with_a_minimum_32_character_secret
QR_HMAC_SECRET=replace_with_a_different_minimum_32_character_secret
TRUST_PROXY=false

# Security policy defaults
SESSION_TTL_SECONDS=120
GEOFENCE_RADIUS_METERS=15
DEVICE_FINGERPRINT_REQUIRED=true

